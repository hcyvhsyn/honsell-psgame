NEXT_PUBLIC_APP_URL=https://honsell.site
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=

# ─── Cloudflare R2 (şəkil saxlama) ───────────────────────────────────────────
# DB Supabase-də qalır; şəkillər R2-də saxlanır (R2 egress PULSUZ → Supabase
# egress problemi həll olunur). Bu dəyişənlər qurulduqda yeni yükləmələr avtomatik
# R2-yə gedir; qurulmayıbsa Supabase storage-a fallback edir (heç nə pozulmur).
#   R2_ACCOUNT_ID            : Cloudflare → R2 → Account ID
#   R2_ACCESS_KEY_ID         : R2 → Manage API Tokens → Access Key ID
#   R2_SECRET_ACCESS_KEY     : həmin token-in Secret-i
#   R2_BUCKET                : bucket adı (məs. honsell-images)
#   NEXT_PUBLIC_R2_PUBLIC_URL: public servis bazası. Boş və ya köhnə host olsa
#                              avtomatik https://honsell.site/cdn (lib/mediaUrl.ts).
#                              honsell.site Cloudflare-ə köçürülsə R2 custom domain
#                              (https://cdn.honsell.site) da olar. Sonda / olmasın.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=honsell-images
NEXT_PUBLIC_R2_PUBLIC_URL=

# Website service AI qiymət hesablama (xidmetler/website forumunda istifadə olunur).
# Açar yoxdursa fallback hesablama qaydaları işə düşür — AI çağırılmır.
OPENAI_API_KEY=

# Streaming scrape (Netflix uNoGS / JustWatch / Gain)
# RapidAPI key — uNoGS endpoint-i üçün (Netflix scraper). https://rapidapi.com/unogs/api/unogs
RAPIDAPI_KEY=
# Shared secret — POST /api/scrape üçün Bearer auth. Vercel Cron-da `authorizationHeader` kimi qoyulur.
CRON_SECRET=
# Gain (login arxasında) — DevTools-dan götürülür, 15-30 gün etibarlıdır.
# GAIN_PROFILE_ID: API URL path-ından çıxan uzun string, məs. "J2YHROODFJFHKVY4F0FIXE3E".
# GAIN_COOKIE: Network → Headers → Request Headers → Cookie sətrinin tam dəyəri.
GAIN_PROFILE_ID=
GAIN_COOKIE=

# HBO Max kataloq kollektoru (lokal, Playwright) — `npm run hbomax:login`, sonra inspect.
# Giriş əl ilə olur; e-poçt/şifrə BURAYA YAZILMIR. Sessiya .hbomax-profile/-də qalır.
HBOMAX_SERIES_URL=
HBOMAX_EPISODE_URL=
# İstəyə bağlı: "Who's watching?" ekranında seçiləcək profil adı.
HBOMAX_PROFILE_NAME=
# İstəyə bağlı: chrome (default, Widevine daxil — player UI üçün lazımdır) | chromium
HBOMAX_BROWSER_CHANNEL=
# İstəyə bağlı: HBOMAX_HOME_URL (default https://play.hbomax.com/), HBOMAX_PROFILE_DIR,
# HBOMAX_HEADLESS=1, HBOMAX_PAGE_DELAY_MS (2500), HBOMAX_NAV_TIMEOUT_MS (45000), HBOMAX_DEBUG=1
# Kollektorun DB-si — MƏCBURİ, DATABASE_URL-ə fallback YOXDUR. Lokal olmayan host yalnız
# HBOMAX_ALLOW_REMOTE_DB=1 ilə (təsdiqlənmiş staging/prod run). Miqrasiya avtomatik işləmir.
HBOMAX_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:55433/honsell_hbomax_dev
# Phase 3 vitrin: HBO Max AZ dil coverage-i (FULL/PARTIAL) yalnız "1" olanda oxunur. YALNIZ
# pending-migrations/20261022090000_content_language_coverage həmin DB-yə tətbiq olunandan SONRA.
HBOMAX_STOREFRONT_COVERAGE=
# Phase 2 — AZ validasiya növbəsi. HBOMAX_PROFILE_NAME validasiya üçün MƏCBURİDİR:
# kollektora ayrıca HBO profili (baxış tarixçəsi başqa profilə düşməsin). Profil seçimi
# tələb olunarsa və ya aktiv profil fərqlidirsə validasiya dayanır.
HBOMAX_VALIDATE_DELAY_MS=8000
HBOMAX_VALIDATE_RETRIES=3
HBOMAX_DAILY_VALIDATION_LIMIT=300
HBOMAX_REVALIDATE_AFTER_DAYS=30
# İstəyə bağlı: HBOMAX_VALIDATE_BACKOFF_MS (3600000), HBOMAX_CMS_DELAY_MS (1200)

# Epic Games kataloq yığımı (GET /api/admin/scrape-epic)
# Epic-in kataloq GraphQL-i Cloudflare bot-challenge arxasındadır və adi server
# sorğularını bloklayır. Onu keçmək üçün self-hosted FlareSolverr instansı lazımdır:
#   docker run -d --name flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# FLARESOLVERR_URL qoyulduqda scrape sorğuları onun üzərindən gedir.
FLARESOLVERR_URL=
# İstəyə bağlı: bir sorğu üçün maksimum gözləmə (ms). Default 60000.
FLARESOLVERR_TIMEOUT_MS=
# İstəyə bağlı: GraphQL endpoint-ini əvəz et (məs. başqa proxy). Default store.epicgames.com.
EPIC_GRAPHQL_URL=


# CRM oyun axtarış API-si (X-API-Key ilə yoxlanır) — /api/games/search
# openssl rand -hex 32 ilə yaradın
GAMES_SEARCH_API_KEY=

# CRM rəy dəvəti API-si (X-API-Key ilə yoxlanır) — /api/partner/review-invites
# CRM tərəfində HONSELL_PARTNER_API_KEY ilə eyni olmalıdır.
# openssl rand -hex 32 ilə yaradın
PARTNER_API_KEY=


# ─── Analitika (self-host) ────────────────────────────────────────────────────
# Layihə öz serverində `next start` ilə işləyir, Vercel-də DEYİL. Ona görə
# @vercel/analytics burdan çıxarıldı — o, yalnız Vercel edge-i ilə işləyir və
# self-host-da heç nə toplamırdı.
#
# Umami (tövsiyə olunur — mövcud Postgres-i işlədə bilir, cookie-siz):
#   NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
#   NEXT_PUBLIC_ANALYTICS_SRC=https://analytics.honsell.site/script.js
#   NEXT_PUBLIC_ANALYTICS_SITE_ID=<umami website id>
#
# Plausible:
#   NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
#   NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.honsell.site/js/script.js
#   NEXT_PUBLIC_ANALYTICS_SITE_ID=honsell.site
#
# Üçü də boş olduqda analitika skripti render OLUNMUR (dev/preview mühitləri
# statistikanı çirkləndirməsin deyə).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# ─── Axtarış sistemi təsdiqi ──────────────────────────────────────────────────
# YALNIZ token dəyəri (bütöv <meta> teqi yox). DNS üsulu ilə təsdiqləmisinizsə
# boş buraxın — env boş olduqda meta teq render olunmur.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Mağaza əhatəsi (lib/storeScope.ts). Boş = yalnız PlayStation məhsulları satılır.
# ALL = bütün kateqoriyalar geri açılır (build-time, `next build` lazımdır).
NEXT_PUBLIC_STORE_SCOPE=

# HBO Max → prod göndərişi (Mac, `npm run hbomax:publish` / admin "Prod-a göndər").
# HBOMAX_IMPORT_TOKEN prod serverin .env-ində də EYNİ dəyərlə olmalıdır (≥32 simvol,
# məs. `openssl rand -hex 32`). Prod-da token yoxdursa /api/hbomax/import 404 verir.
HBOMAX_PUBLISH_URL=
HBOMAX_IMPORT_TOKEN=
